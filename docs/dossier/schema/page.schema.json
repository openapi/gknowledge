{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openapi/gknowledge/docs/dossier/schema/page.schema.json",
  "title": "Page header (YAML frontmatter of a file under knowledge/)",
  "type": "object",
  "required": ["id", "kind", "title", "slug", "sources", "generated", "created", "updated"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "anyOf": [
        {"enum": ["source", "entity", "concept", "topic", "synthesis", "answer"]},
        {"pattern": "^x-[a-z0-9-]+$"}
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "links": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "generated": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created": {"type": "string", "format": "date-time"},
    "updated": {"type": "string", "format": "date-time"}
  },
  "patternProperties": {"^x-": {}},
  "additionalProperties": true
}
